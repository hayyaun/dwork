# Source this file from Bash or Zsh to load shellfunx functions.
# Resolve paths relative to this file, independently of the current directory.
if [ -n "${BASH_VERSION:-}" ]; then
    _shellfunx_file="${BASH_SOURCE[0]}"
elif [ -n "${ZSH_VERSION:-}" ]; then
    _shellfunx_file="${(%):-%x}"
else
    printf "%s\n" "shellfunx: Bash or Zsh is required." >&2
    return 1
fi

_shellfunx_dir=$(CDPATH= cd -- "$(dirname -- "$_shellfunx_file")" && pwd -P) || {
    unset _shellfunx_file _shellfunx_dir
    return 1
}

# Add one explicit source entry here for each new function module.
if . "$_shellfunx_dir/functions/dwork.sh"; then
    unset _shellfunx_file _shellfunx_dir
else
    unset _shellfunx_file _shellfunx_dir
    return 1
fi
