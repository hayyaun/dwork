# Compatibility entry point. New installations should source dwork.sh.
if [ -n "${BASH_VERSION:-}" ]; then
    _dwork_loader_file="${BASH_SOURCE[0]}"
elif [ -n "${ZSH_VERSION:-}" ]; then
    _dwork_loader_file="${(%):-%x}"
else
    printf "%s\n" "dwork: Bash or Zsh is required." >&2
    return 1
fi
_dwork_loader_dir=$(CDPATH= cd -- "$(dirname -- "$_dwork_loader_file")" && pwd -P) || {
    unset _dwork_loader_file _dwork_loader_dir
    return 1
}
if . "$_dwork_loader_dir/dwork.sh"; then
    unset _dwork_loader_file _dwork_loader_dir
else
    unset _dwork_loader_file _dwork_loader_dir
    return 1
fi
