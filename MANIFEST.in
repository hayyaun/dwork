include LICENSE Makefile README.md requirements.txt dwork.sh install.sh
recursive-include lib *.py
recursive-include scripts *.py
recursive-include examples *.md *.yml
recursive-include schemas *.json
recursive-include docs *.md *.png
graft packaging
