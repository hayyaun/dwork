# Maintainer: Hayyan Hami (hayyaun)
pkgname=dwork
pkgver=0.6.0
pkgrel=1
pkgdesc='Switch development workspaces, resume existing containers, and launch terminals'
arch=('any')
url='https://github.com/hayyaun/dwork'
license=('MIT')
depends=('sh' 'python>=3.10' 'python-yaml')
makedepends=('make')
checkdepends=('git' 'zsh' 'python-jsonschema' 'bash-completion')
optdepends=(
  'bash-completion: discover Bash command completions'
  'docker: manage existing project containers'
  'docker-compose: read Compose workspace configuration'
  'gnome-terminal: launch development terminals on GNOME'
  'konsole: launch development terminals on KDE'
  'xfce4-terminal: launch development terminals on Xfce'
  'xterm: launch development terminals on X11'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('822d2089c5631f3db7112b49923da9c3755cc5792383a7fa68f80b019c53a4d0')

check() {
  cd "$srcdir/$pkgname-$pkgver"
  make test PYTHON=/usr/bin/python
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make install VENV=0 PREFIX=/usr DESTDIR="$pkgdir" PYTHON=/usr/bin/python
  # Install explicit entries for native shell completion discovery.
  install -Dm644 "$pkgdir/usr/share/dwork/completions/dwork.bash" \
    "$pkgdir/usr/share/bash-completion/completions/dwork"
  install -d "$pkgdir/usr/share/zsh/site-functions"
  printf '#compdef dwork\nsource /usr/share/dwork/completions/_dwork\n_dwork "$@"\n' \
    > "$pkgdir/usr/share/zsh/site-functions/_dwork"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
